{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/FocusDeck/sensors/claude-code/focusdeck-hook.mjs",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/FocusDeck/sensors/claude-code/focusdeck-hook.mjs",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/FocusDeck/sensors/claude-code/focusdeck-hook.mjs",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
